# Secrets
.env
.env.*.local
*.keyring
*.credentials

# Foundation skill repo (separate upstream; not part of this project)
foundation/

# Local Claude Code session settings (user-specific)
.claude/settings.local.json

# External repos cloned for reference — not part of this project
dsc-smartscraper/

# Operator's filled-in live config (the .example template stays tracked)
config.live.yaml

# Runtime artefacts.
# Use `.tmp/*` (not `.tmp/`) so the `!.tmp/preflight.md.template` exception
# below can actually re-include the template — git refuses to re-include
# children of a directory excluded as a whole.
.tmp/*
# ...except the preflight runbook template, which is tracked so the
# operator has a starting shell for `.tmp/preflight.md` (which stays local).
!.tmp/preflight.md.template
cache/
cache-*/
output/
output-*/
state/
attachments/
*.sqlite
*.sqlite-journal
*.jsonl.zst
*.zst

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
*.log
