# discord-scanner — operator environment template
# Copy to .env and fill in. .env is gitignored (see .gitignore).
#
# SEC-P0-01: Burner token storage priority (highest first):
#   1. keyring (preferred)  — use `discord-scanner store-token`
#   2. DISCORD_TOKEN env var (this file)
#   3. config.yaml discord_token field (last resort)
#
# Never commit a real token. Never share .env. Rotate after any suspected leak.

# Discord burner user-token (not a bot token). Read-only usage.
# DISCORD_TOKEN=

# Logging level: debug | info | warning | error
APP_LOG_LEVEL=info

# Optional override for state + output + attachments root. Defaults to ~/.discord-scanner
# APP_DATA_DIR=~/.discord-scanner
