# config.live.yaml.example — Stage 2 Phase 12.d first live run (smoke profile).
#
# Operator copies this file to `config.live.yaml` (gitignored) and fills in
# `discovery.manual_invites[0]` with the target guild's invite code BEFORE
# running `discord-scanner scan --config config.live.yaml --guild <ID>`.
#
# Smoke-specific choices vs. defaults are called out inline. The single-guild
# scope is enforced via `--guild <ID>` on the CLI rather than a config field
# (config has no per-guild allowlist; CLI flag is the right knob).
#
# Traces to:
#   - PROJECT_WORKPLAN.md §"2.12.c Pre-flight checklist" (smoke caps)
#   - docs/claude/development.md "Runbook 5: First live run on a low-stakes guild"
#   - src/discord_scanner/config.py (Settings model — keep keys in sync)

run:
    output_root: ./output
    state_root: ./state
    # info-level prints scan progress + counters but not per-message debug noise.
    log_level: info

auth:
    # keyring is the only token source we use for live runs (SEC-P0-01 priority 1).
    # Operator must `discord-scanner store-token` first; .env fallback is for tests.
    token_source: keyring
    keyring_service: discord-scanner
    keyring_username: burner-1

gateway:
    # Dormant gateway IDENTIFY is mandatory: a session that only does REST
    # without the WS handshake stands out as a self-bot in Discord telemetry.
    enabled: true
    presence: online

http:
    http2: true
    timeout_sec: 30
    # MUST match config.py default (SEC-P0-08 staleness floor + active fingerprint).
    # The Chrome-UA probe (.github/workflows/chrome-ua-probe.yml) updates this
    # alongside the runtime default; do not pin a different value here.
    user_agent_chrome_version: "148.0.7778.56"
    # Smoke cap: 200 keeps the first run small enough that any anomaly surfaces
    # within minutes. Default is 10_000 — bump back to that after Phase 12.d
    # signs off.
    max_messages_per_scan: 200
    # Baseline rates LOWERED in v2 (was 2.0 / 1.0) — more conservative under
    # sustained scanning + backfill (see workspace plan §"Part A — A.1").
    per_host_rate_per_sec:
        discord.com/api: 1.0
        cdn.discordapp.com: 0.5

    # Adaptive rate limiter (NEW v2).
    # Disabled by default — opt-in via `enabled: true` after a one-week canary
    # on a non-critical burner. State machine: NORMAL → DEGRADED (40-70%
    # reduction on 5xx clusters / latency spikes) → COOLDOWN (10-300s pause on
    # 429 streak / captcha / 403 streak). Orthogonal: probabilistic circadian
    # sleep window + periodic session breaks.
    adaptive:
        enabled: false
        # DEGRADED state factor range (rate × U(low, high)). 0.30-0.60 = "reduce
        # by 40-70% per workspace plan".
        degraded_factor_range: [0.30, 0.60]
        # Triggers
        degrade_on_5xx_in_window: 3
        degrade_on_latency_p95_ms: 4000
        degrade_window_sec: 60
        # DEGRADED → NORMAL: N consecutive successes
        recover_after_successes: 30
        # COOLDOWN triggers + duration
        cooldown_on_consecutive_429: 5
        cooldown_on_captcha: true
        cooldown_on_403_streak: 3
        cooldown_duration_sec: [10, 300]
        # SESSION_BREAK
        session_break_every_requests: 200
        session_break_duration_sec: [60, 180]
        # CIRCADIAN — operator-TZ probabilistic sleep window
        circadian:
            enabled: true
            timezone: Europe/Prague
            sleep_window: "02:00-08:00"
            sleep_probability: 0.95
            twilight_hours: 1.0

discovery:
    # Stage 1 invite-discovery output lands here in production. For the live
    # smoke run we drive a single invite via `manual_invites` and leave the
    # file as a placeholder (the loader tolerates a non-existent file when
    # manual_invites is populated).
    invites_input: invites.json
    manual_invites:
        - "<INVITE_CODE_HERE>"
    filter:
        # Permissive: Stage 1.5 intent classifier has not shipped yet, so any
        # allowlist would gate everything to zero. An empty list means "no
        # intent filter" — every resolved guild passes through.
        intent_allowlist: []

attachments:
    download_images: true
    image_extensions: [.png, .jpg, .webp, .gif]
    # Smoke cap: 5 MB per image (vs. 20 MB default) — keeps the first run's
    # disk + bandwidth footprint small while still exercising the download
    # path. MIME sniff + length guard already cover the security side.
    max_size_mb: 5

daemon:
    # Daemon settings are defined for completeness; the live smoke run is a
    # one-shot `scan` invocation, not `daemon` — these values do not gate it.
    interval_hours: 168
    jitter_hours: [-1, 2]
    scan_start_window: "02:00-06:00 UTC"

retention:
    raw_dump_keep_days: 30
    attachment_keep_days: 14
